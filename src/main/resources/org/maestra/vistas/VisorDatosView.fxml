<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.maestra.controllers.VisorDatosController"
      prefHeight="400.0" prefWidth="800.0">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <HBox spacing="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Button fx:id="btnCargarSesion" onAction="#cargarSesion" text="Cargar sesión" />
        <Button fx:id="btnSumar100" onAction="#sumar100" text="Sumar puntos"/>
    </HBox>
    <HBox spacing="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Label text="Nombre: " />
        <TextField fx:id="txtNombre" style="-fx-background-color: #ffff70; -fx-padding: 10px;" />
        <Button fx:id="btnGuardarNombre" onAction="#GuardarNombre" text="Guardar"/>
    </HBox>
    <VBox spacing="20">
        <Label fx:id="lblResumen"/>
        <Label fx:id="lblLogros"/>
    </VBox>

</VBox>
