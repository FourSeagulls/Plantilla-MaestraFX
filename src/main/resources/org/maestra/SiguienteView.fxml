<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.canvas.Canvas?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.maestra.controllers.SiguienteController">
    <center>
        <Canvas fx:id="drawingCanvas" height="400.0" width="600.0" BorderPane.alignment="CENTER" />
    </center>
    <left>
        <Button fx:id="clearButton" text="Limpiar" BorderPane.alignment="CENTER" onAction="#clearCanvas"/>
    </left>
    <right>
        <VBox spacing="10" alignment="CENTER">

                <Button text="Red" onAction="#setColorRed"/>
                <Button text="Blue" onAction="#setColorBlue"/>
                <Button text="Green" onAction="#setColorGreen"/>
                <Button text="Black" onAction="#setColorBlack"/>
        </VBox>

    </right>
    <bottom>
        <VBox spacing="10" alignment="CENTER">
            <Button fx:id="colorButton" text="Elegir color" onAction="#elegirColor"/>
        </VBox>
    </bottom>
</BorderPane>

